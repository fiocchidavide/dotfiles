{
  "mcpServers": {
    "apple-mail": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--locked",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "mcp-apple-mail",
        "--read-only",
        "--attach-dir",
        "~/Downloads/Mail/outbox",
        "--write-dir",
        "~/Downloads/Mail/saved"
      ]
    }
  }
}
