# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor / tooling cruft
*.swp
*.swo
*~
.idea/
.vscode/

# Stow leftovers
*.stow-tmp

# Safety net against Stow tree-folding onto x/.config (see README): only
# the x package itself belongs in this repo.
x/.config/*
!x/.config/x

# Personal settings for x commands (usernames, 1Password references);
# config.zsh.example is the versioned template.
x/.config/x/config.zsh

# And for vscode: VS Code keeps caches, history and workspace storage next to
# its user config — only keybindings.json is versioned.
vscode/Library/Application Support/Code/User/*
!vscode/Library/Application Support/Code/User/keybindings.json

# And for ghostty: only its config is versioned.
ghostty/Library/Application Support/com.mitchellh.ghostty/*
!ghostty/Library/Application Support/com.mitchellh.ghostty/config.ghostty

# And for claude: ~/.claude holds session history, transcripts, caches and
# credentials — only the global CLAUDE.md is versioned.
claude/.claude/*
!claude/.claude/CLAUDE.md

# Python bytecode (x/.config/x/lib)
__pycache__/

# And for ssh: ~/.ssh holds private keys and known_hosts — only the config
# and public key are versioned.
ssh/.ssh/*
!ssh/.ssh/config
!ssh/.ssh/id_ed25519.pub
