## extract a page range from a PDF with mutool
#@needs mutool
emulate -L zsh
if [[ $1 == (-h|--help) ]]; then
    _x_usage -o "x extrct <input.pdf> <page-range> [output.pdf]" "page-range examples: 1, 1-5, 1,3-5,8"
    return 0
fi
if [[ -z "$1" || -z "$2" ]]; then
    _x_usage "x extrct <input.pdf> <page-range> [output.pdf]" \
        "page-range examples: 1, 1-5, 1,3-5,8"
    return 1
fi
local input="$1"
local pages="$2"
local output="${3:-${input:r}_pages_${pages//,/_}.pdf}"
if [[ ! -f $input ]]; then
    _x_err "No such file: $input"
    return 1
fi
if [[ -e $output ]]; then
    _x_err "Output already exists: $output"
    return 1
fi
mutool merge -o "$output" "$input" "$pages" && _x_ok "Extracted to $output"
