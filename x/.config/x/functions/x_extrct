## extract a page range from a PDF with mutool
#@needs mutool
if [[ -z "$1" || -z "$2" ]]; then
    echo "Usage: x extrct <input.pdf> <page-range> [output.pdf]"
    echo "  page-range examples: 1, 1-5, 1,3-5,8"
    return 1
fi
local input="$1"
local pages="$2"
local output="${3:-${input:r}_pages_${pages//,/_}.pdf}"
mutool merge -o "$output" "$input" "$pages" && echo "📄 Extracted to: $output"
