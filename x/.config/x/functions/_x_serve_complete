# Completion hook for what follows `x serve <target>` (x completes the target).

# `x serve webdav <TAB>` -> the directory to share
[[ ${words[3]} == webdav ]] && (( CURRENT == 4 )) && _files -/

# `x serve off <TAB>` -> which share to stop
if [[ ${words[3]} == (off|stop|down|d) ]] && (( CURRENT == 4 )); then
    local -a shares=('webdav:stop the WebDAV share' 'paseo:stop the paseo share' 'all:stop both')
    _describe 'share' shares
fi
