## extract the contents of a .dmg into a folder (mount, ditto, detach)
#@needs diskutil hdiutil ditto
# Usage: x undmg <image.dmg> [output-dir]
#
# Copies the image's contents out (output-dir: the image name without .dmg,
# next to it).

emulate -L zsh
if [[ -z "$1" ]]; then
    _x_help undmg
    return
fi
local dmg="$1"
local out="${2:-${dmg:r}}"
if [[ ! -f "$dmg" ]]; then
    _x_err "No such file: $dmg"
    return 1
fi
if [[ -e "$out" ]]; then
    _x_err "Output already exists: $out"
    return 1
fi

# Private, unpredictable mount point rather than a fixed /tmp path.
local mnt
mnt=$(mktemp -d "${TMPDIR:-/tmp}/undmg.XXXXXX") || return 1
local attached=0
{
    # --nobrowse: hidden from Finder. Image volumes mount nosuid,nodev anyway.
    diskutil image attach --readOnly --nobrowse --mountPoint "$mnt" "$dmg" >/dev/null \
        || { _x_err "Couldn't attach $dmg"; return 1; }
    attached=1
    if ! ditto "$mnt" "$out"; then
        # $out didn't exist before: whatever is there is a partial copy.
        chmod -R u+w ${out:a} 2>/dev/null
        rm -rf -- $out
        _x_err "Copying out of $dmg failed; nothing was kept."
        return 1
    fi
    _x_ok "Extracted to $out"
} always {
    (( attached )) && hdiutil detach "$mnt" -quiet
    rmdir "$mnt" 2>/dev/null
}
