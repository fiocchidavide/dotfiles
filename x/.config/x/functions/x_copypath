## copy the absolute path of a file to clipboard
#@needs pbcopy
emulate -L zsh
if [[ $1 == (-h|--help) ]]; then
    _x_usage -o "x copypath <file>"
    return 0
fi
if [[ -z "$1" ]]; then
    _x_usage "x copypath <file>"
    return 1
fi
if [[ ! -e "$1" ]]; then
    _x_err "No such file or directory: $1"
    return 1
fi
local abs_path=${1:A}      # absolute, symlinks resolved
printf '%s' "$abs_path" | pbcopy
_x_ok "Copied $abs_path"
