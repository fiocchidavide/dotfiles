## run $CODE_DIR/ocr/infinity_parser on a file
#@needs uv
# Usage: x ocr <file> [extra args...]
#
# OCRs the file with infinity_parser ($CODE_DIR/ocr); extra arguments go to it.

emulate -L zsh
if [[ -z "$1" ]]; then
    _x_help ocr
    return
fi
local dir=${CODE_DIR:-$HOME/Code}/ocr
if [[ ! -f $dir/infinity_parser.py ]]; then
    _x_err "No OCR project at ${dir/#$HOME/~}"
    return 1
fi
uv run --project "$dir" python "$dir/infinity_parser.py" "$@"
