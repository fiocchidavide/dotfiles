## scaffold a new command file and open it in $EDITOR
emulate -L zsh
local name="$1"
[[ -z $name ]] && { _x_usage "x new <name>"; return 1; }
[[ $name == [A-Za-z_]* ]] || { _x_err "A command name must start with a letter or underscore."; return 1; }
local file="$X_FUNCTIONS_DIR/x_${name}"
[[ -e $file ]] && { _x_err "${file/#$HOME/~} already exists (use: x edit $name)"; return 1; }

cat > "$file" <<'EOF'
## TODO: one-line description (shows in `x` help + completion)
# Optional: declare runtime deps for `x doctor`, e.g.:  #@needs curl jq
# Output: _x_step/_x_info/_x_ok/_x_warn/_x_err, _x_usage (see x.zsh).
emulate -L zsh

_x_info "TODO: implement this command"
EOF

_x_ok "Created ${file/#$HOME/~}"
x_reload
${EDITOR:-vi} "$file"
