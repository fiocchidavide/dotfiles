## open a command's source in $EDITOR, then reload
emulate -L zsh
local name="$1"
[[ -z $name ]] && { _x_usage "x edit <name>"; return 1; }
local file="$X_FUNCTIONS_DIR/x_${name}"
[[ -e $file ]] || { _x_err "No command '$name' (create it with: x new $name)"; return 1; }
${=EDITOR:-vi} "$file"     # ${=…}: EDITOR="code --wait" works too
x_reload
