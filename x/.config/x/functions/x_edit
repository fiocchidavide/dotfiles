## open a command's source in $EDITOR, then reload
emulate -L zsh
local name="$1"
[[ -z $name ]] && { print -u2 "Usage: x edit <name>"; return 1; }
local file="$X_FUNCTIONS_DIR/x_${name}"
[[ -e $file ]] || { print -u2 "x edit: no command '$name' (create it with: x new $name)"; return 1; }
${EDITOR:-vi} "$file"
x_reload
