## check that each command's declared dependencies are installed
# Usage: x doctor [command]
#
#   x doctor              check every command's declared dependencies (#@needs)
#   x doctor <command>    check only that command

# Reads `#@needs <bin>…` (required) and `#@needs-optional <bin>…` lines from
# every command file — the same lightweight convention as `## description`.
# Add a dependency to a new command by adding one such line; nothing else.

emulate -L zsh
# Rows are composed in $(…), where stdout is a pipe: decide colour here.
local X_FANCY_OUT; _x_fancy 1 && X_FANCY_OUT=1

local only="$1"
local -a missing_all
local any=0

local f name line rest b
for f in $X_FUNCTIONS_DIR/x_*(N); do
    name=${${f:t}#x_}
    [[ -n $only && $only != $name ]] && continue

    local -a req opt
    req=(); opt=()
    while IFS= read -r line; do
        case $line in
            '#@needs '*)          rest=${line#\#@needs }
                                  rest=${rest%%\#*}          # strip trailing comment
                                  req+=( ${=rest} ) ;;
            '#@needs-optional '*) rest=${line#\#@needs-optional }
                                  rest=${rest%%\#*}
                                  opt+=( ${=rest} ) ;;
        esac
    done < $f

    (( ${#req} + ${#opt} == 0 )) && continue
    any=1

    print -rn -- "  $(_x_paint -o bold ${(r:12:)name}) "
    for b in $req; do
        if command -v "$b" >/dev/null 2>&1; then
            _x_mark ok $b
        else
            _x_mark err $b
            missing_all+=$b
        fi
    done
    for b in $opt; do
        if command -v "$b" >/dev/null 2>&1; then
            _x_mark on $b
        else
            _x_mark off $b
        fi
    done
    print
done

if (( ! any )); then
    [[ -n $only ]] && { _x_err "No command named '$only' with declared dependencies."; return 1; }
    _x_info "No dependencies declared."
    return 0
fi

print
print -rn -- "  "
_x_mark ok present; _x_mark err missing; _x_mark on "optional, present"; _x_mark off "optional, absent"
print
print

if (( ${#missing_all} )); then
    missing_all=( ${(u)missing_all} )   # de-duplicate
    _x_err "Missing required: ${(j:, :)missing_all}"
    local brewfile=${X_DIR:h:h:h}/Brewfile
    if [[ -f $brewfile ]]; then
        # The Brewfile's "not available via Homebrew" section says how to get
        # the rest: "#   webtorrent-cli   ->  pnpm add -g webtorrent-cli".
        local -a via_brew=()
        local hint
        for b in $missing_all; do
            hint=$(sed -nE "s/^#   ${b}[-a-z]* +-> +(.*[^ ]) +\(x .*$/\1/p" $brewfile | head -1)
            if [[ -n $hint ]]; then
                _x_info "$b: $hint"
            else
                via_brew+=$b
            fi
        done
        (( $#via_brew )) && _x_info "Try: brew bundle --file=${brewfile/#$HOME/~}"
    fi
    return 1
fi

_x_ok "All required dependencies present."
return 0
