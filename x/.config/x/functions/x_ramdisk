## create/destroy stacked APFS RAM disks (multiplexed)
#@needs diskutil hdiutil
# Multiplexed APFS RAM disks. State is derived from what's actually mounted
# (dirs matching /Volumes/RAMDisk<N>) rather than a separate stack file, so it
# stays correct across crashes/reboots.
# Usage: x ramdisk <command> …
#
#   x ramdisk create <size_in_GiB>    create the next disk (RAMDisk0, RAMDisk1, …)
#   x ramdisk destroy [<index>|<mountpoint>|all]
#                                     destroy the top of the stack (LIFO), a
#                                     specific one, or all
#   x ramdisk list|ls                 list mounted RAM disks

emulate -L zsh
local prefix="/Volumes/RAMDisk"
local cmd="$1"
[[ $# -gt 0 ]] && shift

# Sets `idx` (local array) to existing indices, numerically sorted ascending.
_x_ramdisk_scan() {
    local -a nums d
    for d in /Volumes/RAMDisk<->(N/); do
        nums+=${${d:t}#RAMDisk}
    done
    idx=( ${(n)nums} )
}

local -a idx

case "$cmd" in
create)
    if (( $# != 1 )); then
        _x_help ramdisk create
        return
    fi
    if ! [[ $1 =~ '^[0-9]+$' ]]; then
        _x_err "The size must be a whole number of GiB."
        return 1
    fi
    local size=$(( 10#$1 ))
    if (( size < 1 || size > 128 )); then
        _x_err "The size must be between 1 and 128 GiB."
        return 1
    fi

    # next index = highest existing + 1 (0 if none)
    _x_ramdisk_scan
    local n=0
    (( ${#idx} )) && n=$(( idx[-1] + 1 ))
    local name="RAMDisk${n}" mp="${prefix}${n}"

    if [[ -d $mp ]]; then
        _x_err "$mp already exists."
        return 1
    fi

    local blocks=$(( size * 2097152 ))   # GiB × 2^21 512-byte blocks
    _x_step "Attaching ram://$blocks (512-byte blocks → ${size}GiB) for $name"
    local device
    device=$(hdiutil attach -nomount ram://$blocks 2>/dev/null \
        | awk '/^\/dev/{print $1; exit}')
    if [[ -z $device ]]; then
        _x_err "hdiutil attach failed."
        return 1
    fi
    _x_info "Device: $device"

    _x_step "Creating APFS container and volume '$name' on $device"
    if ! diskutil apfs create "$device" "$name" >/dev/null; then
        _x_err "Formatting failed."
        hdiutil detach "$device" -force >/dev/null 2>&1
        return 1
    fi

    _x_ok "$name (${size}GiB) ready at $mp (device: $device)"
    print -r -- "$mp"   # stdout: the mount point, for capture by callers
    ;;

destroy)
    local target="$1" mp
    if [[ $target == all ]]; then
        _x_ramdisk_scan
        if (( ! ${#idx} )); then
            _x_info "No RAM disks mounted."
            return 0
        fi
        local i rc=0
        for i in ${(nO)idx}; do   # top-down (LIFO)
            x_ramdisk destroy "$i" || rc=1
        done
        return $rc
    elif [[ -z $target ]]; then
        _x_ramdisk_scan   # default: top of stack
        if (( ! ${#idx} )); then
            _x_err "No RAM disks to destroy."
            return 1
        fi
        mp="${prefix}${idx[-1]}"
    elif [[ $target == /* ]]; then
        mp="$target"
    elif [[ $target =~ '^[0-9]+$' ]]; then
        mp="${prefix}${target}"
    else
        _x_help ramdisk destroy
        return
    fi

    if [[ ! -d $mp ]]; then
        _x_err "No RAM disk found at $mp."
        return 1
    fi

    local device backing
    device=$(df "$mp" 2>/dev/null | awk 'NR==2{print $1}')
    if [[ -z $device ]]; then
        _x_err "Can't determine the device for $mp."
        return 1
    fi
    # backing store = Physical Store of the APFS container (diskNsM -> diskN)
    backing=$(diskutil info "${device%s<->}" | awk '/Physical Store/{print $NF; exit}')
    if [[ -z $backing ]]; then
        _x_err "Can't determine the backing device."
        return 1
    fi
    # Only ever detach a ram:// image: a mount point can name any volume, and
    # detaching its physical store would eject a real disk.
    if ! hdiutil info | awk -v dev="/dev/$backing" '
            /^====/       { ram = 0 }
            /^image-path/ { ram = ($3 ~ /^ram:\/\//) }
            $1 == dev && ram { found = 1 }
            END { exit !found }'; then
        _x_err "$mp isn't a RAM disk; leaving it alone."
        return 1
    fi

    _x_step "Unmounting $mp ($device)"
    diskutil unmount "$mp" >/dev/null || { _x_err "Unmount failed."; return 1; }
    _x_step "Detaching /dev/$backing"
    diskutil eject "/dev/$backing" >/dev/null || { _x_err "Eject failed."; return 1; }

    _x_ok "RAM disk at $mp destroyed"
    ;;

list|ls)
    _x_ramdisk_scan
    if (( ! ${#idx} )); then
        _x_info "No RAM disks mounted."
        return 0
    fi
    local n mp
    for n in $idx; do
        mp="${prefix}${n}"
        _x_item on "$(printf '[%s] %-20s %s' "$n" "$mp" \
            "$(df -h "$mp" 2>/dev/null | awk 'NR==2{print $2" total, "$4" free"}')")"
    done
    ;;

*)
    _x_help ramdisk
    ;;
esac
