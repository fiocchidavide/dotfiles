# Completion hook for what follows `x ramdisk <subcommand>` (x completes the
# subcommand); words[3] is the subcommand.

# `x ramdisk destroy <TAB>` -> mounted indices plus `all`, or a mountpoint
if [[ ${words[3]} == destroy ]] && (( CURRENT == 4 )); then
    if [[ $PREFIX == /* ]]; then
        _files -/
        return
    fi
    local -a targets=(all)
    local d
    for d in /Volumes/RAMDisk<->(N/); do
        targets+=${${d:t}#RAMDisk}
    done
    _describe 'target' targets
elif [[ ${words[3]} == create ]] && (( CURRENT == 4 )); then
    _message 'size in GiB'
fi
