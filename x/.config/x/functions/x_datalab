## convert documents with Datalab (accurate, all output formats)
#@needs op uv
# Usage:
#   x datalab convert [-o outdir] [-p page_range] FILE...
#
# Accurate mode, paginated, page headers and footers kept. Saves every format
# per file into <outdir>/<name>/: .md, .html, .json, .chunks.json,
# .metadata.json and the extracted images (outdir defaults to ./output).
# Shows elapsed time while each file converts; the API reports no percentage.
#
# The API key reference comes from ~/.config/x/config.zsh
# (X_DATALAB_API_KEY_REF) and is read from 1Password per call, never exported.

emulate -L zsh

_x_datalab_convert() {
    local -a o_out o_pages
    zparseopts -D -E -F -- o:=o_out p:=o_pages || return 1
    if (( ! $# )); then
        _x_usage "x datalab convert [-o outdir] [-p page_range] FILE..."
        return 1
    fi
    _x_need_config X_DATALAB_API_KEY_REF || return

    local key
    key=$(op read "$X_DATALAB_API_KEY_REF")
    if [[ -z "$key" ]]; then
        _x_err "Couldn't read the Datalab API key from 1Password."
        return 1
    fi

    # Icons come from x.zsh so the Python side speaks the same design language.
    local fancy=""
    _x_fancy && fancy=1
    DATALAB_API_KEY=$key X_DATALAB_OUT=${o_out[2]:-output} X_DATALAB_PAGES=${o_pages[2]} \
        X_DATALAB_OK="$(_x_icon ok)" X_DATALAB_ERR="$(_x_icon err)" X_DATALAB_FANCY=$fancy \
        X_DATALAB_SGR="${X_COLORS[spin]}" X_QUIET=${X_QUIET:-0} \
        uv run --quiet --no-project --with datalab-python-sdk python - "$@" <<'PY'
import os, sys, threading, time
from pathlib import Path
from datalab_sdk import ConvertOptions, DatalabClient

options = ConvertOptions(
    mode="accurate",
    output_format="markdown,html,json,chunks",
    paginate=True,
    page_range=os.environ["X_DATALAB_PAGES"] or None,
    additional_config={
        "keep_pageheader_in_output": True,
        "keep_pagefooter_in_output": True,
    },
)
OK, ERR = os.environ["X_DATALAB_OK"], os.environ["X_DATALAB_ERR"]
FANCY = bool(os.environ["X_DATALAB_FANCY"])
QUIET = os.environ["X_QUIET"] not in ("", "0")


def dim(text):
    return f"\033[2m{text}\033[0m" if FANCY else text


def elapsed(seconds):
    """Like _x_elapsed: 4.2s / 3:07 / 1:02:03."""
    if seconds < 59.95:
        return f"{seconds:.1f}s"
    s = int(seconds)
    return f"{s // 3600}:{s // 60 % 60:02}:{s % 60:02}" if s >= 3600 else f"{s // 60}:{s % 60:02}"


class Ticker:
    """Show elapsed time while a conversion runs, like _x_spin: a spinner on
    a terminal, a line every 30s otherwise. The API reports no percentage."""

    def __init__(self, label):
        self.label, self.done = label, threading.Event()
        self.thread = threading.Thread(target=self.run, daemon=True)

    def run(self):
        t0, i = time.monotonic(), 0
        while not self.done.wait(0.1 if FANCY else 30):
            took = elapsed(time.monotonic() - t0)
            if FANCY:
                frame = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"[i % 10]
                print(f"\r\033[K\033[{os.environ['X_DATALAB_SGR']}m{frame}\033[0m {self.label} {dim(took)}",
                      end="", file=sys.stderr, flush=True)
                i += 1
            elif not QUIET:
                print(f"{self.label} still converting ({took})", file=sys.stderr)
        if FANCY:
            print("\r\033[K", end="", file=sys.stderr, flush=True)

    def __enter__(self):
        self.thread.start()

    def __exit__(self, *exc):
        self.done.set()
        self.thread.join()


client = DatalabClient()
files = [Path(a) for a in sys.argv[1:]]
# One output folder per input; inputs sharing a name get -2, -3, … rather
# than overwriting each other.
out, dests = Path(os.environ["X_DATALAB_OUT"]), []
for f in files:
    dest, n = out / f.stem, 1
    while dest in dests:
        n += 1
        dest = out / f"{f.stem}-{n}"
    dests.append(dest)

failed = 0
for n, (f, dest) in enumerate(zip(files, dests), 1):
    label = f"[{n}/{len(files)}] {f.name}"
    t0 = time.monotonic()
    error = None
    try:
        with Ticker(label):
            result = client.convert(f, options=options)
        if not result.success:
            error = result.error
    except Exception as e:
        error = e
    took = elapsed(time.monotonic() - t0)
    if error is not None:
        print(f"{ERR} {label} failed after {took}: {error}", file=sys.stderr)
        failed += 1
        continue
    dest.mkdir(parents=True, exist_ok=True)
    result.save_output(dest / f.stem)
    if not QUIET:
        print(f"{OK} {label} → {dest}/ {dim(f'({result.page_count} pages, {took})')}", file=sys.stderr)
    print(dest)  # stdout: the output folder, for capture by callers
sys.exit(1 if failed else 0)
PY
}

case "${1:-}" in
    convert)   shift; _x_datalab_convert "$@" ;;
    ""|-h|--help|help)
        _x_usage ${1:+-o} "x datalab convert [-o outdir] [-p page_range] FILE..." \
            "-o outdir      where results go (default ./output)" \
            "-p page_range  e.g. 0-2,4 (default: all pages)"
        [[ -n "${1:-}" ]] || return 1
        ;;
    *)
        _x_err "Unknown subcommand '$1'. Try: x datalab convert"
        return 1
        ;;
esac
