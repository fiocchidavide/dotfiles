# Usage:
#   x watch <url-or-magnet>            -> plays in IINA (default)
#   x watch iina <url-or-magnet>       -> same, player named explicitly
#   x watch --ram <url-or-magnet>      -> buffers on a RAM disk instead of SSD
#   x watch --ram=16gb <url-or-magnet> -> same, with a custom RAM disk size
#   x watch -s <url-or-magnet>         -> list the torrent's files, with indices
#   x watch -s 3 <url-or-magnet>       -> stream file 3 (indices are 0-based)
#   x watch -i <url-or-magnet>         -> pick that file with an fzf picker
#
# Every flag except --ram and -i is forwarded to webtorrent untouched (-s, -t,
# --playlist, --player-args, ...). Flags that take a separate value are known
# by name, so their value isn't mistaken for the player or the magnet; for any
# flag not in that list, use the --flag=value form. -i can't be combined with
# -s: pick one way to select a file.
#
# -i workaround: webtorrent's own --interactive-select (inquirer) is clunky
# and hard to read. We fetch the file list ourselves the same way `-s` (bare)
# does, parse webtorrent's own listing output, sort it by name, and hand it to
# fzf instead. The picked index is then passed to webtorrent as a normal
# --select. Needs fzf on PATH. The listing probe gets its own throwaway --out
# (see _x_watch_pick_file) so it can't litter the current directory.
#
# --ram workaround: mounts a fresh APFS RAM disk (via `x ramdisk`) at
# /Volumes/RAMDisk<N> and points webtorrent's --out at it, so streamed pieces
# are buffered in RAM instead of the SSD's temp folder. Each run gets its own
# numbered disk, so concurrent `x watch --ram` invocations don't collide.
# The disk is torn down automatically when playback ends (EXIT trap), including
# on Ctrl-C. Default size is 8GiB; override with --ram=<size>[gb].
#
# IINA, formerly a workaround: webtorrent's --iina invokes
# `open iina://weblink?url=<href>` with <href> already URL-encoded. We used to
# shadow `open` with a shim that decoded <href> once, because IINA encoded it a
# second time before fetching (%20 -> %2520). It no longer does: IINA reads the
# url param with URLComponents (which decodes it) and hands the result to
# URL(string:), which under macOS 14+ percent-encodes what it must on its own
# -- see the performPercentEncoding guard in IINA's PlayerCore.openURLString.
# Decoding first is now actively wrong: URLComponents splits query items on
# `&`, so a filename containing one ("The Rick, The Mort & The Ugly.mkv")
# becomes a bogus second query item and IINA fetches the URL truncated at the
# `&` -- a 404. Passing webtorrent's href through untouched round-trips
# exactly, `&` and `[` included, so there is nothing left to shim.
# If double-encoding ever returns (an IINA built with Xcode < 15, or macOS
# < 14), the old decode shim is the fix, but it must then re-encode `&` and `#`
# instead of handing them over raw. Don't reach for `iina-cli` as the escape
# hatch: its argv path percent-encodes unconditionally, so it double-encodes
# every URL with a space in it.
#
# ADDING A PLAYER: define `_x_watch_play_<name>` below, taking the target plus
# any extra webtorrent args. It's picked up by name — no list to keep in sync,
# and `x watch <name> <url>` starts working immediately.
## stream a torrent/url in iina, optionally buffered in RAM
#@needs webtorrent
#@needs-optional iina fzf
# Usage: x watch [player] [--ram[=SIZEgb]] [webtorrent flags] <url-or-magnet>
local player="iina"
local ram_enabled=0
local ram_size=8
local interactive_pick=0
local -a pos=()      # positionals: [player] <url-or-magnet>
local -a wt_args=()  # everything else, forwarded to webtorrent
# webtorrent flags whose value is a separate argument; without this list the
# value ("3" in `-t 3`) would be read as a positional.
local -a wt_valued=(
    -o --out -t --subtitles -b --blocklist -a --announce -p --port
    -d --download-limit -u --upload-limit --player-args --torrent-port
    --dht-port --on-done --on-exit
)
local usage="Usage: x watch [player] [--ram[=SIZEgb]] [webtorrent flags] <url-or-magnet>"

while (( $# )); do
    case "$1" in
        --ram) ram_enabled=1 ;;
        --ram=*)
            ram_enabled=1
            ram_size="${1#--ram=}"
            ram_size="${ram_size%%[gG][bB]}"
            ;;
        -s|--select)
            # --select's value is optional: a bare -s lists the torrent's
            # files, -s <n> streams file n. Only claim a numeric next arg.
            wt_args+=("$1")
            if [[ "$2" == <-> ]]; then
                wt_args+=("$2")
                shift
            fi
            ;;
        -i|--interactive-select)
            # Handled ourselves (fzf), not forwarded to webtorrent.
            interactive_pick=1
            ;;
        -*)
            if (( ${wt_valued[(Ie)$1]} )); then
                if [[ -z "$2" ]]; then
                    echo "❌ $1 needs a value" >&2
                    return 1
                fi
                wt_args+=("$1" "$2")
                shift
            else
                wt_args+=("$1")
            fi
            ;;
        *) pos+=("$1") ;;
    esac
    shift
done

# --ram works by pointing --out at the RAM disk, so the two can't coexist.
local out_given=$(( ${wt_args[(I)-o]} + ${wt_args[(I)--out*]} ))
if (( ram_enabled && out_given )); then
    echo "❌ --ram already sets webtorrent's --out; pass one or the other." >&2
    return 1
fi

if (( ${#pos} > 2 )); then
    echo "❌ Too many arguments: ${(j: :)pos[3,-1]}" >&2
    echo "$usage" >&2
    return 1
fi
if (( ${#pos} == 2 )); then
    player="${pos[1]}"
fi
local target="${pos[${#pos}]}"
if [[ -z "$target" ]]; then
    echo "$usage"
    return 1
fi

_x_watch_play_iina() {
    webtorrent "$1" --iina "${@:2}"
}

# Fetch the torrent's file list the same way `webtorrent -s` (bare) does,
# parse its own listing output, and let fzf pick one. Prints the chosen
# index on stdout; everything else (progress, errors, the fzf UI itself)
# goes to stderr/tty so it doesn't pollute the captured index.
_x_watch_pick_file() {
    local target="$1"
    shift
    if (( ! ${+commands[fzf]} )); then
        echo "❌ -i needs fzf (brew install fzf)." >&2
        return 1
    fi

    echo "🔍 Fetching the file list..." >&2
    # A bare `webtorrent <id> -s` names no player and no --out, so webtorrent
    # falls back to --out=$PWD and creates <cwd>/<torrent name>/ as soon as it
    # adds the torrent -- before it has even printed the listing it then exits
    # on. Unchecked, every `x watch -i` leaves an empty folder behind in
    # whatever directory it ran from. Give the probe a throwaway --out (last
    # one wins in webtorrent's parser, so this also overrides a user -o for
    # the probe only) and drop it once the list is parsed.
    local probe_out listing
    probe_out=$(mktemp -d) || return 1
    listing=$(webtorrent "$target" -s "$@" --out "$probe_out" 2>&1)
    rm -rf -- "$probe_out"

    # Entries are "<name> (<size>)\t<index>": the name leads so a plain sort
    # orders them alphabetically, and fzf shows field 1 while the index rides
    # along in field 2.
    local -a files=()
    local ln
    for ln in ${(f)listing}; do
        if [[ "$ln" =~ '^[[:space:]]*([0-9]+)[[:space:]]+(.+)[[:space:]]\(([^()]+)\)[[:space:]]*$' ]]; then
            files+=("${match[2]} (${match[3]})"$'\t'"${match[1]}")
        fi
    done

    if (( ! ${#files} )); then
        echo "❌ Couldn't get a file list from webtorrent:" >&2
        echo "$listing" >&2
        return 1
    fi

    files=( "${(@oi)files}" )  # o: ascending, i: case-insensitive

    local chosen
    if (( ${#files} == 1 )); then
        chosen="${files[1]}"
    else
        chosen=$(printf '%s\n' "${files[@]}" | fzf --prompt="Stream which file? " --delimiter=$'\t' --with-nth=1 --height=~40% --layout=reverse --border) || return 1
    fi
    [[ -z "$chosen" ]] && return 1

    print -r -- "${chosen##*$'\t'}"
}

# Resolve the player before any RAM disk is built, so a typo doesn't cost a
# mount/unmount cycle.
local play="_x_watch_play_${player}"
if (( ! ${+functions[$play]} )); then
    local -a known=( ${${(ok)functions[(I)_x_watch_play_*]}#_x_watch_play_} )
    echo "❌ Unknown player '$player'. Supported: ${(j:, :)known}" >&2
    return 1
fi

if (( interactive_pick )); then
    if (( ${wt_args[(I)-s]} + ${wt_args[(I)--select]} )); then
        echo "❌ Use either -i or -s, not both." >&2
        return 1
    fi
    local picked
    picked=$(_x_watch_pick_file "$target" "${wt_args[@]}") || return 1
    wt_args+=(--select "$picked")
fi

local -a wt_out=()
if (( ram_enabled )); then
    echo "💾 Creating ${ram_size}GiB RAM disk for the streaming buffer..."
    # Multiplexed: create a fresh disk and capture its own mount point, so
    # concurrent `x watch --ram` runs each get an independent buffer.
    local ram_mp
    ram_mp=$(x_ramdisk create "$ram_size") || return 1
    # zsh: an EXIT trap set inside a function fires when the function
    # returns (not just on shell exit), so this tears down the RAM disk
    # on normal completion, early return, or Ctrl-C alike. Destroy this
    # run's specific disk (not just top-of-stack) to stay correct under
    # concurrent runs.
    trap 'echo "🧹 Destroying RAM disk..."; x_ramdisk destroy "$ram_mp"' EXIT
    wt_out=(--out "$ram_mp")
fi

"$play" "$target" "${wt_out[@]}" "${wt_args[@]}"
