## download a URL and extract the archive
#@needs curl aunpack
# Check if a URL was provided
if [[ -z "$1" ]]; then
    _x_usage "x dw <url>"
    return 1
fi

local url="$1"
local file_name

_x_step "Downloading $url"

# Download the file and capture the dynamically generated file name.
# -f: an HTTP error fails instead of saving the error page as the archive.
if ! file_name=$(curl -fsSL -O -J -w "%{filename_effective}" "$url"); then
    _x_err "Download failed."
    return 1
fi

# Check if the file actually exists on disk now
if [[ ! -f "$file_name" ]]; then
    _x_err "Download failed or no file was created."
    return 1
fi

_x_step "Extracting $file_name"

# Run aunpack. If it succeeds, remove the archive.
if aunpack "$file_name"; then
    rm "$file_name"
    _x_ok "Extracted and removed $file_name"
else
    _x_err "Extraction failed; archive kept for debugging: $file_name"
    return 1
fi
