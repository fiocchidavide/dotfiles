## download a URL fast with aria2c (max parallel connections)
#@needs aria2c
emulate -L zsh
if [[ -z "$1" ]]; then
    _x_usage "x fastdw <url> [aria2c args...]"
    return 1
fi
aria2c \
    -x 16 -s 16 -k 1M \
    --max-connection-per-server=16 \
    --min-split-size=1M \
    --file-allocation=none \
    --optimize-concurrent-downloads=true \
    "$@"
