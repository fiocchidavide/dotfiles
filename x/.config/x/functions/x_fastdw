## download a URL fast with aria2c (max parallel connections)
#@needs aria2c
# Usage: x fastdw <url> [aria2c args...]
#
# Downloads over 16 parallel connections; extra arguments go to aria2c.

emulate -L zsh
if [[ -z "$1" ]]; then
    _x_help fastdw
    return
fi
aria2c \
    -x 16 -s 16 -k 1M \
    --max-connection-per-server=16 \
    --min-split-size=1M \
    --file-allocation=none \
    --optimize-concurrent-downloads=true \
    "$@"
