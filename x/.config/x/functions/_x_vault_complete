# Completion hook for `x vault …`; words[3] is the subcommand.
local -a subcmds=(
    'init:settings, 1Password vault and first key'
    'put:seal files or folders into staging (--direct: straight to Drive)'
    'push:upload staged archives, offer to delete originals'
    'ls:list archives by original path'
    'get:download and extract an archive'
    'key:print one archive'"'"'s passphrase'
    'keys:list, create, switch or retire master keys'
    'rekey:re-encrypt archives under another key'
    'rm:delete archives from Drive and the index'
    'check:compare the index with Drive'
    'share:one-off encrypted share for a friend'
)

if (( CURRENT == 3 )); then
    _describe 'subcommand' subcmds
    return
fi

# _arguments counts arguments from words[2]: drop `x vault` so the subcommand
# is words[1] and `1:` means its first argument.
local sub=${words[3]}
shift 2 words
(( CURRENT -= 2 ))

case $sub in
    push)  _arguments '--all[push everything staged, no picker]' '-n[list what would be pushed]' '*:staged archive or path:' ;;
    put)   _arguments '--direct[stream straight to Drive, no staging copy]' '-k[master key id]:key id:' '*:file or folder:_files' ;;
    get)   _arguments '-C[folder to extract into]:directory:_files -/' '1:archive or path:_guard "^-*" "archive or path"' ;;
    ls)    _arguments '-l[show archive names]' '1:pattern:_guard "^-*" "pattern"' ;;
    rm)    _arguments '-n[dry run]' '*:archive or path:' ;;
    share) _arguments '--to[where the friend'"'"'s copy goes]:directory:' '1:file or folder:_files' ;;
    keys)
        if (( CURRENT == 2 )); then
            local -a keycmds=('new:create a master key' 'use:make a key current' 'retire:mark a key retired or compromised')
            _describe 'keys subcommand' keycmds
        elif [[ ${words[2]} == new ]]; then
            _arguments '--use[make it the current key]'
        elif [[ ${words[2]} == retire ]]; then
            shift words
            (( CURRENT-- ))
            _arguments '--compromised[mark it compromised rather than retired]' '1:key id:_guard "^-*" "key id"'
        fi
        ;;
    rekey)
        _arguments \
            '*--from[archives under this key]:key id:' \
            '*--status[archives under keys with this status]:status:(retired compromised active)' \
            '*--match[glob on the original path]:glob:' \
            '--before[sealed before this date]:YYYY-MM-DD:' \
            '--larger[larger than]:size (e.g. 2G):' \
            '--smaller[smaller than]:size (e.g. 500M):' \
            '--to[target key (default: current)]:key id:' \
            '--all[every archive not already under the target key]' \
            '-n[dry run]' \
            '-i[pick interactively with fzf]' \
            '*:archive or path:'
        ;;
esac
